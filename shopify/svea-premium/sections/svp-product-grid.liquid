{%- comment -%}
  Svea Premium – Produkter.
  Up to 3 cards per row. Mobile (<750px): with 2+ cards a horizontal scroll-snap row, one card about 80% wide and
  the next one peeking in (stacked 4:5 cards filled a whole screen per product); a single card stays full width.
  Card: image slot 4:5 (block image → product image if use_product_image → placeholder), serif name, one line of
  text, price (lowest storefront variant price, never struck through) and an "Upptäck" link.
  The whole card is one link (stretched link on the name), so there is one tab stop per card.
  Blocks without a product are skipped on the storefront (the editor shows a hint card); with no valid cards the
  section renders nothing.
  Extra settings beyond CONTRACT.md: price_prefix (printed only on cards whose product has more than one storefront
  price, product.price_varies, so a single-price product never reads "Från 249 kr"; clear it to never show it),
  link_label. Note: PDRN has one storefront variant (bundles come from Kaching), so its card reads "399 kr".
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign tone = s.tone | default: 'cream'
  assign pad = s.pad | default: 'm'
  assign anchor_id = s.anchor | remove: '#' | handleize
  assign link_label = s.link_label | default: 'Upptäck'

  assign n_valid = 0
  for block in section.blocks
    if block.type == 'product' and block.settings.product != blank and block.settings.product.url != blank
      assign n_valid = n_valid | plus: 1
    endif
  endfor

  assign n_cards = n_valid
  if request.design_mode
    assign n_cards = section.blocks.size
  endif
  assign cols = n_cards
  if cols > 3
    assign cols = 3
  endif

  assign has_head = false
  if s.eyebrow != blank or s.heading != blank or s.intro != blank
    assign has_head = true
  endif
-%}
{%- if n_cards > 0 -%}
<div id="svp-{{ section.id }}" class="svp svp-product-grid svp-tone--{{ tone }} svp-pad--{{ pad }}">
  {%- if anchor_id != blank -%}<span class="svp-anchor" id="{{ anchor_id }}"></span>{%- endif -%}
  <div class="svp-container">
    {%- if has_head -%}
      <div class="svp-pgrid__head svp-reveal">
        <div class="svp-pgrid__headmain">
          {%- if s.eyebrow != blank -%}
            <p class="svp-eyebrow">{{ s.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="svp-pgrid__h svp-h2">{{ s.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if s.intro != blank -%}
          <div class="svp-pgrid__intro svp-rte">{{ s.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="svp-pgrid__list svp-pgrid__list--{{ cols }}{% if n_cards > 1 %} svp-pgrid__list--scroll{% endif %}{% unless has_head %} svp-pgrid__list--center{% endunless %}" style="--svp-pg-cols: {{ cols }}" role="list">
      {%- assign i = 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign p = b.product
          assign ok = false
          if block.type == 'product' and p != blank and p.url != blank
            assign ok = true
          endif
          assign show_card = ok
          if block.type == 'product' and request.design_mode
            assign show_card = true
          endif
        -%}
        {%- if show_card -%}
        {%- liquid
          assign i = i | plus: 1
          assign delay = i | minus: 1 | times: 0.08

          assign href = blank
          if ok
            assign href = p.url
            assign view = b.view | strip | remove_first: '?view=' | remove_first: 'view=' | remove_first: 'product.' | remove: '.json'
            if view != blank
              assign view = view | handleize
              assign href = href | append: '?view=' | append: view
            endif
          endif

          assign name = b.title_override
          if name == blank and ok
            assign name = p.title
          endif

          assign img = b.image
          if img == blank and s.use_product_image and ok
            assign img = p.featured_image
          endif
        -%}
        <li class="svp-pgrid__card svp-reveal" style="--svp-delay: {{ delay }}s" {{ block.shopify_attributes }}>
          <div class="svp-pgrid__media">
            {%- render 'svp-image', image: img, ratio: '4:5', word: b.placeholder_word, alt: '', sizes: '(min-width: 1320px) 400px, (min-width: 750px) 31vw, 100vw', class: 'svp-pgrid__ar' -%}
          </div>
          <div class="svp-pgrid__body">
            {%- if ok -%}
              <h3 class="svp-pgrid__name svp-h3">
                <a class="svp-pgrid__link" href="{{ href }}">{{ name | escape }}</a>
              </h3>
              {%- if b.text != blank -%}
                <p class="svp-pgrid__text">{{ b.text | escape | replace: '–', '&#8288;–&#8288;' }}</p>
              {%- endif -%}
              <div class="svp-pgrid__foot">
                {%- if s.show_price -%}
                  <p class="svp-pgrid__price">
                    {%- if s.price_prefix != blank and p.price_varies -%}
                      <span class="svp-pgrid__from">{{ s.price_prefix | escape }}</span>{{ ' ' }}
                    {%- endif -%}
                    <span class="svp-pgrid__amt">{{ p.price_min | money_without_trailing_zeros }}</span>
                    {%- unless p.available -%}{{ ' ' }}<span class="svp-pgrid__soldout">· Tillfälligt slut</span>{%- endunless -%}
                  </p>
                {%- endif -%}
                <span class="svp-pgrid__more" aria-hidden="true">
                  <span>{{ link_label | escape }}</span>
                  {%- render 'svp-icon', name: 'arrow', size: 18, class: 'svp-pgrid__arrow' -%}
                </span>
              </div>
            {%- else -%}
              {%- if name != blank -%}<h3 class="svp-pgrid__name svp-h3">{{ name | escape }}</h3>{%- endif -%}
              <p class="svp-pgrid__hint">Välj en produkt för det här kortet. Kort utan produkt visas inte i butiken.</p>
            {%- endif -%}
          </div>
        </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .svp-product-grid .svp-pgrid__head { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 20px; margin-bottom: 40px; }
  .svp-product-grid .svp-pgrid__h { margin: 0; text-wrap: balance; }
  .svp-product-grid .svp-pgrid__intro { max-width: 560px; color: var(--svp-fg-soft); }

  .svp-product-grid .svp-pgrid__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 56px; }
  .svp-product-grid .svp-pgrid__card { position: relative; display: flex; flex-direction: column; margin: 0; padding: 0; min-width: 0; }
  .svp-product-grid .svp-pgrid__media { position: relative; }
  .svp-product-grid .svp-pgrid__media .svp-media > img { transition: transform 1.2s cubic-bezier(.2, .6, .2, 1); }
  .svp-product-grid .svp-pgrid__card:hover .svp-media > img { transform: scale(1.03); }
  .svp-product-grid .svp-pgrid__body { display: flex; flex-direction: column; flex: 1 1 auto; padding-top: 22px; }
  .svp-product-grid .svp-pgrid__name { margin: 0; }
  .svp-product-grid:not(#svp_) .svp-pgrid__link { color: inherit !important; text-decoration: none !important; font: inherit; }
  .svp-product-grid .svp-pgrid__link::after { content: ""; position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; }
  .svp-product-grid:not(#svp_) .svp-pgrid__link:focus-visible { outline: none; }
  .svp-product-grid .svp-pgrid__link:focus-visible::after { outline: 2px solid var(--svp-focus); outline-offset: 6px; }
  .svp-product-grid .svp-pgrid__text { margin: 8px 0 0; color: var(--svp-fg-soft); line-height: 1.5; }
  .svp-product-grid .svp-pgrid__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 20px; margin-top: auto; padding-top: 18px; }
  .svp-product-grid .svp-pgrid__text + .svp-pgrid__foot { padding-top: 18px; }
  .svp-product-grid .svp-pgrid__price { margin: 0; line-height: 1.3; }
  .svp-product-grid .svp-pgrid__from { color: var(--svp-fg-soft); }
  .svp-product-grid .svp-pgrid__amt { font-weight: 500; color: var(--svp-fg); font-variant-numeric: lining-nums; }
  .svp-product-grid .svp-pgrid__soldout { font-size: 15px; color: var(--svp-fg-soft); }
  .svp-product-grid .svp-pgrid__more { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--svp-link); font-weight: 500; }
  .svp-product-grid .svp-pgrid__more > span { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; }
  .svp-product-grid .svp-pgrid__card:hover .svp-pgrid__more > span { text-decoration-color: var(--svp-coral); text-decoration-thickness: 2px; }
  .svp-product-grid .svp-pgrid__arrow { transition: transform .2s ease; }
  .svp-product-grid .svp-pgrid__card:hover .svp-pgrid__arrow { transform: translateX(3px); }
  .svp-product-grid .svp-pgrid__hint { margin: 10px 0 0; padding: 14px 16px; border: 1px dashed var(--svp-rule); font-size: 15px; line-height: 1.5; color: var(--svp-fg-soft); }

  @media (max-width: 749px) {
    /* 2+ cards: horizontal scroll-snap row that runs to the screen edges; the next card peeks in */
    .svp-product-grid .svp-pgrid__list--scroll { display: flex; gap: 16px; overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-left: var(--svp-gutter); scroll-padding-right: var(--svp-gutter); margin: -8px calc(var(--svp-gutter) * -1); padding: 8px var(--svp-gutter); scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .svp-product-grid .svp-pgrid__list--scroll::-webkit-scrollbar { display: none; }
    .svp-product-grid .svp-pgrid__list--scroll > .svp-pgrid__card { flex: 0 0 80%; max-width: 340px; scroll-snap-align: start; }
    /* cards that start off-screen sideways would wait for the reveal observer: show them at once */
    .svp-product-grid .svp-pgrid__list--scroll > .svp-pgrid__card.svp-pre { opacity: 1; transform: none; transition: none; }
    .svp-product-grid .svp-pgrid__list--scroll .svp-pgrid__link:focus-visible::after { outline-offset: 4px; }
  }
  @media (min-width: 750px) {
    .svp-product-grid .svp-pgrid__head { margin-bottom: 48px; }
    /* Every column is one third wide, so one or two cards keep the same size and line up with the heading */
    .svp-product-grid .svp-pgrid__list { --svp-pg-x: 20px; gap: 48px var(--svp-pg-x); grid-template-columns: repeat(var(--svp-pg-cols, 3), calc((100% - 2 * var(--svp-pg-x)) / 3)); justify-content: start; }
    .svp-product-grid .svp-pgrid__list--center { justify-content: center; }
  }
  @media (min-width: 990px) {
    .svp-product-grid .svp-pgrid__head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(48px, 6vw, 96px); align-items: end; margin-bottom: 64px; }
    .svp-product-grid .svp-pgrid__list { --svp-pg-x: 32px; row-gap: 64px; }
    .svp-product-grid .svp-pgrid__body { padding-top: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .svp-product-grid .svp-pgrid__media .svp-media > img, .svp-product-grid .svp-pgrid__arrow { transition: none; }
    .svp-product-grid .svp-pgrid__card:hover .svp-media > img, .svp-product-grid .svp-pgrid__card:hover .svp-pgrid__arrow { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Svea Premium – Produkter",
  "class": "svp-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Rubrik" },
    { "type": "text", "id": "eyebrow", "label": "Etikett ovanför rubriken" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Rubrik",
      "info": "Gör ett eller två ord kursiva för betoning.",
      "default": "Utvalt från <em>Svea Skin.</em>"
    },
    { "type": "richtext", "id": "intro", "label": "Ingress" },
    { "type": "header", "content": "Korten" },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Visa pris",
      "info": "Lägsta pris bland varianterna. Visas aldrig överstruket.",
      "default": true
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Ord före priset",
      "info": "Till exempel Från. Visas bara för produkter med flera priser, till exempel paket. Töm fältet för att aldrig visa det.",
      "default": "Från"
    },
    {
      "type": "checkbox",
      "id": "use_product_image",
      "label": "Använd produktens första bild när kortet saknar bild",
      "info": "Annars visas en tonad platshållare tills du väljer en bild i kortet.",
      "default": false
    },
    { "type": "text", "id": "link_label", "label": "Länktext på korten", "default": "Upptäck" },
    { "type": "header", "content": "Utseende" },
    {
      "type": "select",
      "id": "tone",
      "label": "Bakgrund",
      "options": [
        { "value": "cream", "label": "Kräm" },
        { "value": "sand", "label": "Sand" },
        { "value": "blush", "label": "Rosa" },
        { "value": "white", "label": "Vit" },
        { "value": "wine", "label": "Mörk vinröd" }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "pad",
      "label": "Luft ovanför och under",
      "options": [
        { "value": "s", "label": "Liten" },
        { "value": "m", "label": "Mellan" },
        { "value": "l", "label": "Stor" }
      ],
      "default": "m"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ankar-id för sektionen",
      "info": "Till exempel produkter. Då kan knappar länka hit med #produkter."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produktkort",
      "settings": [
        { "type": "product", "id": "product", "label": "Produkt" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild",
          "info": "Tom = produktens första bild om det är valt i sektionen, annars en tonad platshållare."
        },
        {
          "type": "text",
          "id": "placeholder_word",
          "label": "Ord i platshållaren",
          "info": "Visas stort och kursivt när ingen bild visas."
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Namn på kortet",
          "info": "Tomt = produktens namn."
        },
        { "type": "text", "id": "text", "label": "En rad om produkten" },
        {
          "type": "text",
          "id": "view",
          "label": "Produktsidans mall (valfri)",
          "info": "Mallens suffix, till exempel pdrn-b-spegel. Tomt = standardmallen."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Svea Premium – Produkter",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
