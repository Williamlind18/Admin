{%- comment -%}
  Svea Premium – Ingredienser. Editorial ingredient cards (number, hairline, tag; serif name; serif-italic sub; short
  text), a small disclaimer, the full INCI list in a <details> (hidden when blank) and a framed warning box.
  Cards: a hairline list on mobile, 2 columns from 750px, 3 from 990px (4 from 1200px when there are 4 or 8 cards).
  Extra settings beyond CONTRACT.md: show_numbers.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign tone = s.tone | default: 'cream'
  assign pad = s.pad | default: 'm'
  assign anchor_id = s.anchor | remove: '#' | handleize

  assign count = 0
  for block in section.blocks
    if block.settings.name != blank or block.settings.text != blank
      assign count = count | plus: 1
    endif
  endfor
  assign cols = 3
  if count == 1
    assign cols = 1
  elsif count == 2
    assign cols = 2
  elsif count == 4 or count == 8
    assign cols = 4
  endif

  assign has_head = false
  if s.eyebrow != blank or s.heading != blank or s.intro != blank
    assign has_head = true
  endif
  assign has_info = false
  if s.disclaimer != blank or s.inci != blank
    assign has_info = true
  endif
  assign inci_label = s.inci_title | default: 'Fullständig ingredienslista'
-%}
<div id="svp-{{ section.id }}" class="svp svp-ingredients svp-ingredients--c{{ cols }}{% if s.intro != blank %} svp-ingredients--intro{% endif %} svp-tone--{{ tone }} svp-pad--{{ pad }}">
  {%- if anchor_id != blank -%}<span class="svp-anchor" id="{{ anchor_id }}"></span>{%- endif -%}
  <div class="svp-container">
    {%- if has_head -%}
      <div class="svp-ingredients__head svp-reveal">
        {%- if s.eyebrow != blank or s.heading != blank -%}
          <div class="svp-ingredients__hl">
            {%- if s.eyebrow != blank -%}<p class="svp-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
            {%- if s.heading != blank -%}<h2 class="svp-h2 svp-ingredients__h">{{ s.heading }}</h2>{%- endif -%}
          </div>
        {%- endif -%}
        {%- if s.intro != blank -%}<div class="svp-rte svp-lead svp-ingredients__intro">{{ s.intro }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if count > 0 -%}
      <ul class="svp-ingredients__grid" role="list">
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- if b.name != blank or b.text != blank -%}
            {%- assign n = n | plus: 1 -%}
            {%- assign delay = forloop.index0 | modulo: 4 | times: 0.06 -%}
            <li class="svp-ingredients__card svp-reveal" style="--svp-delay: {{ delay }}s;" {{ block.shopify_attributes }}>
              {%- if s.show_numbers or b.tag != blank -%}
                <div class="svp-ingredients__top{% unless s.show_numbers %} svp-ingredients__top--tagfirst{% endunless %}">
                  {%- if s.show_numbers -%}
                    <span class="svp-num svp-ingredients__n" aria-hidden="true">{% if n < 10 %}0{% endif %}{{ n }}</span>
                    <span class="svp-ingredients__rule" aria-hidden="true"></span>
                    {%- if b.tag != blank -%}<span class="svp-ingredients__tag">{{ b.tag | escape }}</span>{%- endif -%}
                  {%- else -%}
                    <span class="svp-ingredients__tag">{{ b.tag | escape }}</span>
                    <span class="svp-ingredients__rule" aria-hidden="true"></span>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if b.name != blank -%}<h3 class="svp-h3 svp-ingredients__name">{{ b.name | escape }}</h3>{%- endif -%}
              {%- if b.sub != blank -%}<p class="svp-ingredients__sub svp-serif">{{ b.sub | escape }}</p>{%- endif -%}
              {%- if b.text != blank -%}<div class="svp-rte svp-ingredients__text">{{ b.text }}</div>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if has_info or s.warning != blank -%}
      <div class="svp-ingredients__foot{% if has_info and s.warning != blank %} svp-ingredients__foot--two{% endif %} svp-reveal">
        {%- if has_info -%}
          <div class="svp-ingredients__info">
            {%- if s.disclaimer != blank -%}<div class="svp-rte svp-ingredients__disc">{{ s.disclaimer }}</div>{%- endif -%}
            {%- if s.inci != blank -%}
              <details class="svp-acc svp-ingredients__inci">
                <summary><span>{{ inci_label | escape }}</span></summary>
                <div class="svp-acc__body svp-rte svp-ingredients__inci-list">{{ s.inci }}</div>
              </details>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if s.warning != blank -%}
          <div class="svp-ingredients__warn" role="note">
            {%- render 'svp-icon', name: 'sun', size: 24, class: 'svp-ingredients__warn-icon' -%}
            <div class="svp-rte svp-ingredients__warn-text">{{ s.warning }}</div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .svp-ingredients .svp-ingredients__head { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 20px; margin-bottom: 40px; }
  .svp-ingredients .svp-ingredients__h { margin: 0; max-width: 820px; }
  .svp-ingredients .svp-ingredients__intro { max-width: 560px; color: var(--svp-fg); }

  .svp-ingredients .svp-ingredients__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .svp-ingredients .svp-ingredients__card { display: flex; flex-direction: column; min-width: 0; margin: 0; padding: 24px 22px 28px; background: var(--svp-panel); }
  .svp-ingredients .svp-ingredients__top { display: flex; align-items: center; gap: 14px; margin: 0 0 22px; min-height: 20px; }
  .svp-ingredients .svp-ingredients__top--tagfirst .svp-ingredients__tag { text-align: left; }
  .svp-ingredients .svp-ingredients__n { flex: none; line-height: 1; }
  .svp-ingredients .svp-ingredients__rule { flex: 1 1 auto; min-width: 24px; height: 1px; background: var(--svp-rule); }
  .svp-ingredients .svp-ingredients__tag { flex: none; max-width: 70%; font-size: 13px; font-weight: 500; line-height: 1.3; letter-spacing: .14em; text-transform: uppercase; color: var(--svp-accent); text-align: right; }
  .svp-ingredients .svp-ingredients__name { margin: 0; text-wrap: balance; hyphens: manual; }
  .svp-ingredients .svp-ingredients__sub { margin: 6px 0 0; font-size: 18px; line-height: 1.35; font-style: italic; font-variant-caps: normal; letter-spacing: 0; color: var(--svp-fg-soft); text-wrap: balance; }
  .svp-ingredients .svp-ingredients__text { margin-top: 16px; }
  .svp-ingredients .svp-ingredients__name + .svp-ingredients__text { margin-top: 14px; }

  .svp-ingredients .svp-ingredients__foot { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 32px; margin-top: 40px; }
  .svp-ingredients .svp-ingredients__disc { max-width: 640px; font-size: 15px; line-height: 1.55; color: var(--svp-fg-soft); }
  .svp-ingredients .svp-ingredients__disc + .svp-ingredients__inci { margin-top: 24px; }
  .svp.svp-ingredients .svp-ingredients__inci > summary { font-size: 17px; }
  .svp.svp-ingredients .svp-ingredients__inci-list { font-size: 15px; line-height: 1.6; color: var(--svp-fg-soft); padding-right: 0; }
  .svp-ingredients .svp-ingredients__warn { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 16px; align-items: start; padding: 24px 22px; border: 1px solid var(--svp-accent); }
  .svp-ingredients .svp-ingredients__warn-icon { margin-top: 1px; color: var(--svp-accent); }
  .svp-ingredients .svp-ingredients__warn-text p { margin-bottom: .6em; }
  .svp-ingredients .svp-ingredients__warn-text p:last-child { margin-bottom: 0; }

  @media (max-width: 749px) {
    .svp-ingredients .svp-ingredients__grid { gap: 0; }
    .svp-ingredients .svp-ingredients__card { padding: 24px 0 26px; background: transparent; border-top: 1px solid var(--svp-rule); }
    .svp-ingredients .svp-ingredients__card:last-child { border-bottom: 1px solid var(--svp-rule); }
    .svp-ingredients .svp-ingredients__top { margin-bottom: 12px; }
    /* the row hairline already separates the items: keep the number/tag spacing, drop the inner rule */
    .svp-ingredients .svp-ingredients__rule { background: transparent; }
    .svp-ingredients .svp-ingredients__text { margin-top: 10px; }
    .svp-ingredients .svp-ingredients__name + .svp-ingredients__text { margin-top: 10px; }
  }
  @media (min-width: 750px) {
    .svp-ingredients--c2 .svp-ingredients__grid,
    .svp-ingredients--c3 .svp-ingredients__grid,
    .svp-ingredients--c4 .svp-ingredients__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
    .svp-ingredients--c1 .svp-ingredients__grid { max-width: 640px; }
    .svp-ingredients .svp-ingredients__card { padding: 32px 28px 36px; }
    .svp-ingredients .svp-ingredients__warn { padding: 28px; column-gap: 18px; }
  }
  @media (min-width: 990px) {
    .svp-ingredients .svp-ingredients__head { margin-bottom: 64px; }
    .svp-ingredients--intro .svp-ingredients__head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(48px, 6vw, 96px); align-items: end; }
    .svp-ingredients--c3 .svp-ingredients__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .svp-ingredients .svp-ingredients__card { padding: 36px 32px 40px; }
    .svp-ingredients .svp-ingredients__top { margin-bottom: 36px; }
    .svp-ingredients .svp-ingredients__foot { margin-top: 56px; }
    .svp-ingredients .svp-ingredients__foot--two { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(48px, 6vw, 96px); align-items: start; }
  }
  @media (min-width: 1200px) {
    .svp-ingredients--c4 .svp-ingredients__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
    .svp-ingredients--c4 .svp-ingredients__card { padding: 32px 26px 36px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Svea Premium – Innehåll",
  "class": "svp-section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Innehåll" },
    { "type": "text", "id": "eyebrow", "label": "Etikett ovanför rubriken", "default": "Ingredienser" },
    { "type": "inline_richtext", "id": "heading", "label": "Rubrik", "info": "Gör ett eller två ord kursiva för betoning.", "default": "Varje ingrediens <em>har ett skäl.</em>" },
    { "type": "richtext", "id": "intro", "label": "Ingress", "default": "<p>Här är det viktigaste i formeln, och vad vi säger om varje del.</p>" },
    { "type": "checkbox", "id": "show_numbers", "label": "Visa nummer på korten (01, 02 …)", "default": true },
    { "type": "header", "content": "Under korten" },
    { "type": "richtext", "id": "disclaimer", "label": "Förbehåll (liten text)", "default": "<p>Beskrivningarna avser råvarornas egenskaper.</p>" },
    { "type": "text", "id": "inci_title", "label": "Rubrik för ingredienslistan", "default": "Fullständig ingredienslista" },
    { "type": "richtext", "id": "inci", "label": "Fullständig ingredienslista (INCI)", "info": "Visas i en utfällbar rad. Döljs helt när fältet är tomt." },
    { "type": "richtext", "id": "warning", "label": "Varningstext", "info": "Visas i en inramad ruta, till exempel retinolvarningen.", "default": "<p><strong>Innehåller retinol (vitamin A).</strong> Använd solskydd på dagen. Rekommenderas inte vid graviditet eller amning.</p><p>Innehåller vitamin A. Tänk på ditt dagliga intag innan användning.</p>" },
    { "type": "header", "content": "Utseende" },
    {
      "type": "select", "id": "tone", "label": "Bakgrund",
      "options": [
        { "value": "cream", "label": "Kräm" },
        { "value": "sand", "label": "Sand" },
        { "value": "blush", "label": "Rosa" },
        { "value": "white", "label": "Vit" },
        { "value": "wine", "label": "Mörk vinröd" }
      ],
      "default": "cream"
    },
    {
      "type": "select", "id": "pad", "label": "Luft ovanför och under",
      "options": [
        { "value": "s", "label": "Liten" },
        { "value": "m", "label": "Mellan" },
        { "value": "l", "label": "Stor" }
      ],
      "default": "m"
    },
    { "type": "text", "id": "anchor", "label": "Ankar-id för sektionen", "info": "Till exempel ingredienser. Då kan knappar länka hit med #ingredienser." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingrediens",
      "settings": [
        { "type": "text", "id": "name", "label": "Namn", "default": "Ingrediens" },
        { "type": "text", "id": "sub", "label": "Underrad", "info": "Ursprung eller typ. Visas i kursiv under namnet." },
        { "type": "richtext", "id": "text", "label": "Text", "info": "Skriv hur huden ser ut eller känns, aldrig vad ingrediensen gör i huden." },
        { "type": "text", "id": "tag", "label": "Etikett (valfri)", "info": "Ett eller två ord, till exempel Fukt." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Svea Premium – Ingredienser",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Kollagen och hyaluronsyra", "sub": "Fukt och spänst", "tag": "Fukt", "text": "<p>Binder fukt i ytan, så att huden känns mjukare och spänstigare.</p>" } },
        { "type": "ingredient", "settings": { "name": "Koffein och adenosin", "sub": "För ögonpartiet", "tag": "Utvilad", "text": "<p>För ett mindre trött och svullet intryck.</p>" } },
        { "type": "ingredient", "settings": { "name": "Peptider", "sub": "I små mängder", "tag": "Jämnhet", "text": "<p>För en jämnare och slätare yta.</p>" } }
      ]
    }
  ]
}
{% endschema %}
