{%- comment -%}
  Svea Premium – Vanliga frågor. Native <details> accordion with hairlines (svp-acc from svp-base.css).
  layout "split": heading left (sticky on desktop), questions right. layout "stacked": centred heading, list below.
  schema = true prints FAQPage JSON-LD (answers with HTML stripped, everything JSON-escaped). Use it on one FAQ
  section per page. The section heading is an h2; there is never an h1 here.
  Extra settings beyond CONTRACT.md: open_first.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign tone = s.tone | default: 'cream'
  assign pad = s.pad | default: 'm'
  assign layout = s.layout | default: 'split'
  assign anchor_id = s.anchor | remove: '#' | handleize

  assign count = 0
  for block in section.blocks
    if block.settings.question != blank and block.settings.answer != blank
      assign count = count | plus: 1
    endif
  endfor

  assign has_head = false
  if s.eyebrow != blank or s.heading != blank or s.intro != blank
    assign has_head = true
  endif
  assign show_link = false
  if s.link_label != blank and s.link_url != blank
    assign show_link = true
  endif
-%}
<div id="svp-{{ section.id }}" class="svp svp-faq svp-faq--{{ layout }}{% unless has_head %} svp-faq--nohead{% endunless %} svp-tone--{{ tone }} svp-pad--{{ pad }}">
  {%- if anchor_id != blank -%}<span class="svp-anchor" id="{{ anchor_id }}"></span>{%- endif -%}
  <div class="svp-container">
    <div class="svp-faq__wrap">
      {%- if has_head -%}
        <div class="svp-faq__head">
          <div class="svp-faq__head-in svp-reveal">
            {%- if s.eyebrow != blank -%}<p class="svp-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
            {%- if s.heading != blank -%}<h2 class="svp-h2 svp-faq__h">{{ s.heading }}</h2>{%- endif -%}
            {%- if s.intro != blank -%}<div class="svp-rte svp-faq__intro">{{ s.intro }}</div>{%- endif -%}
          </div>
        </div>
      {%- endif -%}
      {%- if count > 0 or show_link -%}
        <div class="svp-faq__body svp-reveal" style="--svp-delay: .08s;">
          {%- if count > 0 -%}
            <div class="svp-faq__list">
              {%- assign n = 0 -%}
              {%- for block in section.blocks -%}
                {%- assign b = block.settings -%}
                {%- if b.question != blank and b.answer != blank -%}
                  {%- assign n = n | plus: 1 -%}
                  <details class="svp-acc svp-faq__item" id="svp-faq-{{ block.id }}"{% if s.open_first and n == 1 %} open{% endif %} {{ block.shopify_attributes }}>
                    <summary><span class="svp-faq__q">{{ b.question | escape }}</span></summary>
                    <div class="svp-acc__body svp-rte svp-faq__a">{{ b.answer }}</div>
                  </details>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if show_link -%}
            <div class="svp-actions svp-faq__actions">
              <a class="svp-cta svp-cta--link" href="{{ s.link_url }}">
                <span>{{ s.link_label | escape }}</span>
                {%- render 'svp-icon', name: 'arrow', size: 18, class: 'svp-cta__arrow' -%}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if s.schema and count > 0 -%}
    {%- capture svp_faq_ld -%}
      {%- assign first = true -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- if b.question != blank and b.answer != blank -%}
          {%- liquid
            assign q = b.question | strip_html | split: ' ' | join: ' '
            assign a = b.answer | replace: '</p>', '</p> ' | replace: '<br>', ' ' | replace: '<br/>', ' ' | replace: '<br />', ' ' | replace: '</li>', '</li> ' | strip_html
            assign a = a | replace: '&nbsp;', ' ' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
            assign a = a | split: ' ' | join: ' '
          -%}
          {%- unless first -%},{%- endunless -%}
          {"@type":"Question","name":{{ q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ a | json }}}}
          {%- assign first = false -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ svp_faq_ld }}]}</script>
  {%- endif -%}

  {%- if request.design_mode -%}
    <script>
      (function () {
        var root = document.getElementById('svp-{{ section.id }}');
        if (!root || root.dataset.svpFaqInit) return;
        root.dataset.svpFaqInit = '1';
        document.addEventListener('shopify:block:select', function (e) {
          var d = e.target && e.target.closest ? e.target.closest('details.svp-faq__item') : null;
          if (d && root.contains(d)) d.open = true;
        });
      })();
    </script>
  {%- endif -%}
</div>

{% stylesheet %}
  .svp-faq .svp-faq__head { margin-bottom: 32px; }
  .svp-faq .svp-faq__h { margin: 0; max-width: 760px; }
  .svp-faq .svp-faq__intro { margin-top: 20px; max-width: 520px; }
  .svp.svp-faq .svp-faq__item > summary { padding: 20px 0; }
  .svp-faq .svp-faq__q { min-width: 0; text-wrap: pretty; }
  .svp.svp-faq .svp-faq__a { padding: 0 32px 28px 0; max-width: 680px; }
  .svp.svp-faq .svp-faq__actions { margin-top: 28px; }

  /* stacked: centred heading, list in a reading column */
  .svp-faq--stacked .svp-faq__head { text-align: center; }
  .svp-faq--stacked .svp-faq__h,
  .svp-faq--stacked .svp-faq__intro { margin-left: auto; margin-right: auto; }
  .svp-faq--stacked .svp-faq__body { max-width: 820px; margin: 0 auto; }
  .svp-faq--stacked .svp-faq__actions { justify-content: center; }

  @media (min-width: 990px) {
    .svp-faq .svp-faq__head { margin-bottom: 56px; }
    .svp.svp-faq .svp-faq__item > summary { padding: 24px 0; font-size: 19px; }
    .svp-faq--split .svp-faq__wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(48px, 6vw, 96px); align-items: start; }
    .svp-faq--split.svp-faq--nohead .svp-faq__wrap { grid-template-columns: minmax(0, 1fr); }
    .svp-faq--split.svp-faq--nohead .svp-faq__body { max-width: 820px; }
    .svp-faq--split .svp-faq__head { margin: 0; height: 100%; }
    .svp-faq--split .svp-faq__head-in { position: sticky; top: 120px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Svea Premium – Frågor",
  "class": "svp-section",
  "max_blocks": 24,
  "settings": [
    { "type": "header", "content": "Innehåll" },
    { "type": "text", "id": "eyebrow", "label": "Etikett ovanför rubriken", "default": "Frågor och svar" },
    { "type": "inline_richtext", "id": "heading", "label": "Rubrik", "info": "Visas som H2. Gör ett eller två ord kursiva för betoning.", "default": "Raka svar <em>innan du bestämmer dig.</em>" },
    { "type": "richtext", "id": "intro", "label": "Ingress" },
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "split", "label": "Rubrik till vänster, frågor till höger" },
        { "value": "stacked", "label": "Rubrik ovanför, centrerad" }
      ],
      "default": "split"
    },
    { "type": "checkbox", "id": "open_first", "label": "Visa första svaret öppet", "default": false },
    { "type": "checkbox", "id": "schema", "label": "Lägg till strukturerade data (FAQPage) för Google", "info": "Använd bara på en frågesektion per sida.", "default": true },
    { "type": "header", "content": "Länk under frågorna" },
    { "type": "text", "id": "link_label", "label": "Länktext", "default": "Kontakta oss" },
    { "type": "url", "id": "link_url", "label": "Länk", "info": "Länken visas bara när både text och länk är ifyllda." },
    { "type": "header", "content": "Utseende" },
    {
      "type": "select", "id": "tone", "label": "Bakgrund",
      "options": [
        { "value": "cream", "label": "Kräm" },
        { "value": "sand", "label": "Sand" },
        { "value": "blush", "label": "Rosa" },
        { "value": "white", "label": "Vit" },
        { "value": "wine", "label": "Mörk vinröd" }
      ],
      "default": "cream"
    },
    {
      "type": "select", "id": "pad", "label": "Luft ovanför och under",
      "options": [
        { "value": "s", "label": "Liten" },
        { "value": "m", "label": "Mellan" },
        { "value": "l", "label": "Stor" }
      ],
      "default": "m"
    },
    { "type": "text", "id": "anchor", "label": "Ankar-id för sektionen", "info": "Till exempel fragor. Då kan knappar länka hit med #fragor." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Fråga",
      "settings": [
        { "type": "text", "id": "question", "label": "Fråga", "default": "Fråga" },
        { "type": "richtext", "id": "answer", "label": "Svar", "default": "<p>Svar.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Svea Premium – Vanliga frågor",
      "blocks": [
        { "type": "question", "settings": { "question": "Hur länge räcker ett stift?", "answer": "<p>Ungefär en månad, om du använder det morgon och kväll.</p>" } },
        { "type": "question", "settings": { "question": "Hur fungerar öppet köp?", "answer": "<p>Du har sextio dagar från leveransdagen, även om du har börjat använda produkten. Skicka tillbaka det som är kvar tillsammans med förpackningen, så får du pengarna tillbaka. Returfrakten står du för.</p>" } },
        { "type": "question", "settings": { "question": "När kommer paketet?", "answer": "<p>Vi skickar från svenskt lager med PostNord. Leveranstiden är 1–3 arbetsdagar.</p>" } }
      ]
    }
  ]
}
{% endschema %}
