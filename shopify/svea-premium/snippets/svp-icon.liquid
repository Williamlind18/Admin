{%- comment -%}
  Svea Premium – line icon. Inline SVG, 24 viewBox, stroke 1.5, currentColor, aria-hidden.
  Paths drawn after Lucide (ISC licence).

  Params:
  - name:  truck | return | chat | lock | pin | leaf | clock | drop | check | card | plus | minus | arrow | sun
  - size:  px, default 24
  - class: extra classes

  Usage: {% render 'svp-icon', name: 'truck', size: 22 %}
{%- endcomment -%}
{%- assign _s = size | default: 24 -%}
<svg class="svp-icon svp-icon--{{ name }}{% if class != blank %} {{ class }}{% endif %}" width="{{ _s }}" height="{{ _s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'truck' -%}
      <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
    {%- when 'return' -%}
      <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>
    {%- when 'chat' -%}
      <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
    {%- when 'lock' -%}
      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
    {%- when 'pin' -%}
      <path d="M20 10c0 5-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 15 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
    {%- when 'leaf' -%}
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
    {%- when 'drop' -%}
      <path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>
    {%- when 'check' -%}
      <path d="M20 6 9 17l-5-5"/>
    {%- when 'card' -%}
      <rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/>
    {%- when 'plus' -%}
      <path d="M5 12h14"/><path d="M12 5v14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
    {%- else -%}
      <circle cx="12" cy="12" r="1.5"/>
  {%- endcase -%}
</svg>
