{%- comment -%}
  Svea Premium – Faktarad. A calm spec strip: big serif values, small sans labels, hairlines between.
  2 columns on mobile (an odd last fact spans the row), up to 4 columns from 750px (more facts wrap to new rows).
  Where subgrid is supported, every fact spans two shared grid rows (value, label): values sit on a common bottom line
  and all labels in a row start at the same height, even when a long value wraps to two lines.
  Extra settings beyond CONTRACT.md: anchor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign tone = s.tone | default: 'cream'
  assign pad = s.pad | default: 's'
  assign anchor_id = s.anchor | remove: '#' | handleize

  assign count = 0
  for block in section.blocks
    if block.settings.value != blank or block.settings.label != blank
      assign count = count | plus: 1
    endif
  endfor
  assign cols = count
  if cols > 4
    assign cols = 4
  endif
  assign odd = count | modulo: 2
-%}
<div id="svp-{{ section.id }}" class="svp svp-facts svp-tone--{{ tone }} svp-pad--{{ pad }}{% if odd == 1 %} svp-facts--odd{% endif %}">
  {%- if anchor_id != blank -%}<span class="svp-anchor" id="{{ anchor_id }}"></span>{%- endif -%}
  <div class="svp-container">
    {%- if s.heading != blank -%}
      <h2 class="svp-facts__h svp-reveal">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if count > 0 -%}
      <ul class="svp-facts__list svp-reveal" role="list" style="--svp-facts-cols: {{ cols }};">
        {%- for block in section.blocks -%}
          {%- if block.settings.value != blank or block.settings.label != blank -%}
            <li class="svp-facts__item" {{ block.shopify_attributes }}>
              {%- if block.settings.value != blank -%}
                <span class="svp-facts__value svp-serif">{{ block.settings.value | escape | replace: '–', '&#8288;–&#8288;' }}</span>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <span class="svp-facts__label">{{ block.settings.label | escape | replace: '–', '&#8288;–&#8288;' }}</span>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .svp-facts .svp-facts__h { margin: 0 auto 28px; max-width: 760px; text-align: center; font-size: 24px; line-height: 1.25; }
  .svp-facts .svp-facts__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--svp-rule); border-bottom: 1px solid var(--svp-rule); overflow: hidden; }
  /* Inner hairlines: every cell draws its own left and top line, shifted 1px so the outer edges are clipped away */
  .svp-facts .svp-facts__item { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 10px; margin: -1px 0 0 -1px; padding: 28px 10px 26px; border-left: 1px solid var(--svp-rule); border-top: 1px solid var(--svp-rule); text-align: center; min-width: 0; }
  .svp-facts--odd .svp-facts__item:last-child { grid-column: 1 / -1; }
  .svp-facts .svp-facts__value { display: block; font-size: 30px; line-height: 1.08; letter-spacing: -0.015em; font-weight: 400; color: var(--svp-heading); font-variant-numeric: lining-nums; text-wrap: balance; }
  .svp-facts .svp-facts__label { display: block; max-width: 22ch; font-size: 15px; line-height: 1.45; color: var(--svp-fg-soft); text-wrap: balance; }

  @supports (grid-template-rows: subgrid) {
    .svp-facts .svp-facts__list { grid-auto-rows: auto; }
    .svp-facts .svp-facts__item { display: grid; grid-row: span 2; grid-template-rows: subgrid; grid-template-columns: minmax(0, 1fr); row-gap: 10px; justify-items: center; align-content: start; }
    .svp-facts .svp-facts__value { align-self: end; }
    .svp-facts .svp-facts__label { align-self: start; }
    .svp-facts .svp-facts__item > :only-child { grid-row: 1 / -1; align-self: center; }
  }
  @media (min-width: 750px) {
    .svp-facts .svp-facts__list { grid-template-columns: repeat(var(--svp-facts-cols, 4), minmax(0, 1fr)); }
    .svp-facts--odd .svp-facts__item:last-child { grid-column: auto; }
    .svp-facts .svp-facts__item { padding: 36px 20px 34px; gap: 12px; row-gap: 12px; }
    .svp-facts .svp-facts__value { font-size: clamp(30px, 3.4vw, 50px); }
    .svp-facts .svp-facts__label { font-size: 16px; }
  }
  @media (min-width: 990px) {
    .svp-facts .svp-facts__h { font-size: 28px; margin-bottom: 36px; }
    .svp-facts .svp-facts__item { padding: 44px 28px 40px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Svea Premium – Faktarad",
  "class": "svp-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik (valfri)"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Bakgrund",
      "options": [
        { "value": "cream", "label": "Kräm" },
        { "value": "sand", "label": "Sand" },
        { "value": "blush", "label": "Rosa" },
        { "value": "white", "label": "Vit" },
        { "value": "wine", "label": "Mörk vinröd" }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "pad",
      "label": "Luft ovanför och under",
      "options": [
        { "value": "s", "label": "Liten" },
        { "value": "m", "label": "Mellan" },
        { "value": "l", "label": "Stor" }
      ],
      "default": "s"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ankar-id för sektionen",
      "info": "Till exempel fakta. Då kan knappar länka hit med #fakta."
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fakta",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Värde",
          "info": "Kort, till exempel 10 g eller 60 dagar. Visas stort."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etikett",
          "info": "Till exempel öppet köp, även påbörjat."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Svea Premium – Faktarad",
      "blocks": [
        { "type": "fact", "settings": { "value": "60 dagar", "label": "öppet köp, även på påbörjad produkt" } },
        { "type": "fact", "settings": { "value": "1–3 dagar", "label": "leverans med PostNord" } },
        { "type": "fact", "settings": { "value": "499 kr", "label": "gräns för fri frakt" } },
        { "type": "fact", "settings": { "value": "Svenskt", "label": "lager, bolag och kundtjänst" } }
      ]
    }
  ]
}
{% endschema %}
